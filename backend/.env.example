# ======================================================================
# SCI · Sistema de Cobranzas Inteligente — variables de entorno del backend
# Copia este archivo a ".env" y completa con tus credenciales reales.
# NUNCA subas el .env al repositorio.
# ======================================================================

# --- App ---
ENVIRONMENT=development

# --- WhatsApp: proveedor del canal ---
# "cloud"   = API oficial de Meta (producción, requiere las WA_* de abajo).
# "neonize" = WhatsApp Web NO oficial (solo pruebas; login por QR, sin webhook).
#             ⚠️ Contra los Términos de Meta: usa un número de prueba, no el real.
WA_PROVIDER=cloud
WA_NEONIZE_SESSION=sci_wa.db
# Segundos de gracia antes de ignorar un mensaje "sin contacto previo" (0 = no espera).
WA_GRACIA_SEGUNDOS=0

# --- WhatsApp Cloud API (Meta for Developers) ---
# Token de acceso (System User token para prod; token temporal para pruebas)
WA_ACCESS_TOKEN=
# Phone Number ID de tu WABA (no es el número, es el ID numérico)
WA_PHONE_NUMBER_ID=
# Token que tú inventas y configuras también en el panel del webhook de Meta
WA_VERIFY_TOKEN=sci-verify-token
WA_API_VERSION=v21.0

# --- Twilio (SMS + número de voz) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número E.164 (p. ej. +1XXXXXXXXXX) o sender ID alfanumérico (p. ej. SCI)
TWILIO_SMS_FROM=

# --- Vapi (Voz AI) ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- LLM del bot conversacional (proveedor configurable) ---
# Proveedor: "gemini" (gratis, sin tarjeta) · "groq" (gratis) · "openai" (mejores
# resultados). Los tres usan la API de chat de OpenAI, solo cambia base_url/modelo.
LLM_PROVIDER=gemini
# API key del proveedor elegido (Gemini AI Studio / Groq / OpenAI).
LLM_API_KEY=
# Modelo por proveedor:
#   gemini → gemini-2.5-flash   | groq → llama-3.3-70b-versatile   | openai → gpt-4o-mini
LLM_MODEL=gemini-2.5-flash
# Opcional: forzar un base_url; si se deja vacío se deriva del LLM_PROVIDER.
LLM_BASE_URL=

# --- OpenAI (solo si LLM_PROVIDER=openai; también es el fallback de LLM_API_KEY) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Cumplimiento (Indecopi Art. 62b) ---
# true (producción): solo contacta 07:00–20:00, sin domingos/feriados.
# false (pruebas): salta esa validación para poder probar fuera de horario.
COMPLIANCE_ENABLED=true
COMPLIANCE_HORA_INICIO=7
COMPLIANCE_HORA_FIN=20

# --- Autenticación (JWT) ---
# Usa una cadena larga y aleatoria (>=32 caracteres) en producción.
JWT_SECRET=cambia-esto-en-produccion-sci-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Base de datos ---
DATABASE_URL=sqlite:///./sci.db
